<body>
<main>
    <h1>CSC418 Assignment Submission Portal</h1>
    <p class="subtitle">DevOps Lab Midterm — static demonstration</p>

    <form id="submission-form">
        <label for="student-name">Student Name</label>
        <input id="student-name" name="student_name" required>

        <label for="registration-number">Registration Number</label>
        <input id="registration-number" name="registration_number" required>

        <label for="assignment-title">Assignment Title</label>
        <input id="assignment-title" name="assignment_title" required>

        <label for="submission-url">Submission URL</label>
        <input id="submission-url" name="submission_url" type="url"
               placeholder="https://github.com/..." required>

        <button type="submit">Submit Assignment</button>
    </form>

    <div id="message" aria-live="polite"></div>
    <h2>Saved Submissions</h2>
    <div id="submissions"></div>
</main>
<script>
    const storageKey = "csc418-submissions";
    const form = document.querySelector("#submission-form");
    const message = document.querySelector("#message");
    const list = document.querySelector("#submissions");

    function renderSubmissions() {
        const submissions = JSON.parse(localStorage.getItem(storageKey) || "[]");
        list.replaceChildren();
        if (!submissions.length) {
            list.textContent = "No submissions yet.";
            return;
        }

        const wrapper = document.createElement("div");
        wrapper.className = "table-wrapper";
        const table = document.createElement("table");
        table.innerHTML = "<thead><tr><th>Name</th><th>Registration</th>" +
            "<th>Assignment</th><th>URL</th></tr></thead><tbody></tbody>";
        const body = table.querySelector("tbody");

        for (const submission of submissions) {
            const row = body.insertRow();
            for (const value of [
                submission.student_name,
                submission.registration_number,
                submission.assignment_title
            ]) {
                row.insertCell().textContent = value;
            }
            const linkCell = row.insertCell();
            const link = document.createElement("a");
            link.href = submission.submission_url;
            link.target = "_blank";
            link.rel = "noopener noreferrer";
            link.textContent = "Open";
            linkCell.append(link);
        }

        wrapper.append(table);
        list.append(wrapper);
    }

    form.addEventListener("submit", (event) => {
        event.preventDefault();
        const data = new FormData(form);
        const url = String(data.get("submission_url")).trim();
        let parsedUrl;
        try {
            parsedUrl = new URL(url);
        } catch {
            parsedUrl = null;
        }

        if (!parsedUrl || !["http:", "https:"].includes(parsedUrl.protocol)) {
            message.className = "message error";
            message.textContent = "Please enter a valid http/https URL.";
            return;
        }

        const submissions = JSON.parse(localStorage.getItem(storageKey) || "[]");
        submissions.push({
            student_name: String(data.get("student_name")).trim(),
            registration_number: String(data.get("registration_number")).trim(),
            assignment_title: String(data.get("assignment_title")).trim(),
            submission_url: url
        });
        localStorage.setItem(storageKey, JSON.stringify(submissions));
        form.reset();
        message.className = "message success";
        message.textContent = "Submission saved successfully in this browser.";
        renderSubmissions();
    });

    renderSubmissions();
</script>
</body>
</html>
