name: Assignment Portal CI

on:
  push:
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  test:
    runs-on: [self-hosted, windows]
    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install dependencies
        run: python -m pip install -r requirements.txt

      - name: Run tests and send report to localhost
        env:
          GITHUB_REPOSITORY: ${{ github.repository }}
          GITHUB_REF_NAME: ${{ github.ref_name }}
          GITHUB_SHA: ${{ github.sha }}
          GITHUB_RUN_ID: ${{ github.run_id }}
          REPORT_RECEIVER_URL: http://127.0.0.1:9000/report
        shell: pwsh
        run: |
          $receiver = Start-Process `
            -FilePath python `
            -ArgumentList @("-u", "receiver/receiver.py") `
            -WorkingDirectory $env:GITHUB_WORKSPACE `
            -PassThru `
            -RedirectStandardOutput receiver.log `
            -RedirectStandardError receiver-error.log

          try {
            $receiverReady = $false
            for ($attempt = 0; $attempt -lt 30; $attempt++) {
              try {
                $null = Invoke-RestMethod `
                  -Uri "http://127.0.0.1:9000/health" `
                  -TimeoutSec 2
                $receiverReady = $true
                break
              }
              catch {
                Start-Sleep -Seconds 1
              }
            }

            if (-not $receiverReady) {
              Get-Content receiver-error.log -ErrorAction SilentlyContinue
              throw "The local report receiver did not start."
            }

            python -m pytest -v --json-report --json-report-file=pytest-report.json
            $testStatus = $LASTEXITCODE

            python scripts/build_report.py --input pytest-report.json
            $reportStatus = $LASTEXITCODE
            if ($reportStatus -ne 0) {
              $exitStatus = $reportStatus
            }
            else {
              $exitStatus = $testStatus
            }
          }
          finally {
            Stop-Process -Id $receiver.Id -ErrorAction SilentlyContinue
          }
          exit $exitStatus

      - name: Email test report
        if: always() && hashFiles('test-report.json') != ''
        env:
          REPORT_EMAIL_TO: ${{ secrets.REPORT_EMAIL_TO }}
          REPORT_EMAIL_FROM: ${{ secrets.REPORT_EMAIL_FROM }}
          SMTP_HOST: ${{ secrets.SMTP_HOST }}
          SMTP_PORT: ${{ secrets.SMTP_PORT }}
          SMTP_USERNAME: ${{ secrets.SMTP_USERNAME }}
          SMTP_PASSWORD: ${{ secrets.SMTP_PASSWORD }}
          SMTP_USE_SSL: ${{ secrets.SMTP_USE_SSL }}
        run: python scripts/send_email.py --report test-report.json

      - name: Upload test reports
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: test-reports-${{ github.run_id }}
          path: |
            test-report.json
            pytest-report.json
            receiver.log
            receiver-error.log
          if-no-files-found: warn

  deploy-pages:
    if: needs.test.result == 'success' && github.event_name == 'push' && github.ref == 'refs/heads/main'
    needs: test
    runs-on: ubuntu-latest
    permissions:
      contents: read
      pages: write
      id-token: write
    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Configure GitHub Pages
        uses: actions/configure-pages@v5

      - name: Upload static demo
        uses: actions/upload-pages-artifact@v3
        with:
          path: site

      - name: Deploy static demo
        id: deployment
        uses: actions/deploy-pages@v4
