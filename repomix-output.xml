import pytest
from app import app, submissions


@pytest.fixture
def client():
    app.config["TESTING"] = True

    submissions.clear()

    with app.test_client() as client:
        yield client

    submissions.clear()


def test_valid_submission(client):
    response = client.post(
        "/",
